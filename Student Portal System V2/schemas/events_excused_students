create table public.event_excused_students (
  id uuid not null default extensions.gen_random_uuid (),
  event_id uuid not null,
  student_id uuid not null,
  reason text not null,
  created_by uuid null,
  created_at timestamp with time zone not null default now(),
  updated_at timestamp with time zone not null default now(),
  proof_filename text null,
  proof_mime text null,
  proof_data bytea null,
  proof_uploaded_at timestamp with time zone null,
  revoked_at timestamp with time zone null,
  revoked_by uuid null,
  proof_uploaded_by uuid null,
  revoked_reason text null,
  invalidation_proof_filename text null,
  invalidation_proof_mime text null,
  invalidation_proof_data bytea null,
  invalidation_proof_uploaded_at timestamp with time zone null,
  invalidation_proof_uploaded_by uuid null,
  invalidation_conditions jsonb null,
  constraint event_excused_students_pkey primary key (id),
  constraint event_excused_students_event_student_unique unique (event_id, student_id),
  constraint event_excused_students_student_id_fkey foreign KEY (student_id) references students (id) on delete CASCADE,
  constraint event_excused_students_event_id_fkey foreign KEY (event_id) references events (id) on delete CASCADE,
  constraint event_excused_students_invalidation_proof_size check (
    (
      (invalidation_proof_data is null)
      or (octet_length(invalidation_proof_data) <= 10485760)
    )
  ),
  constraint event_excused_students_invalidation_proof_complete check (
    (
      (
        (invalidation_proof_data is null)
        and (invalidation_proof_filename is null)
        and (invalidation_proof_mime is null)
        and (invalidation_proof_uploaded_at is null)
        and (invalidation_proof_uploaded_by is null)
      )
      or (
        (invalidation_proof_data is not null)
        and (
          NULLIF(btrim(invalidation_proof_filename), ''::text) is not null
        )
        and (
          NULLIF(btrim(invalidation_proof_mime), ''::text) is not null
        )
        and (invalidation_proof_uploaded_at is not null)
        and (invalidation_proof_uploaded_by is not null)
      )
    )
  ),
  constraint event_excused_students_proof_complete check (
    (
      (
        (proof_data is null)
        and (proof_filename is null)
        and (proof_mime is null)
        and (proof_uploaded_at is null)
        and (proof_uploaded_by is null)
      )
      or (
        (proof_data is not null)
        and (
          NULLIF(btrim(proof_filename), ''::text) is not null
        )
        and (NULLIF(btrim(proof_mime), ''::text) is not null)
        and (proof_uploaded_at is not null)
      )
    )
  ),
  constraint event_excused_students_proof_size check (
    (
      (proof_data is null)
      or (octet_length(proof_data) <= 10485760)
    )
  ),
  constraint event_excused_students_reason_check check (
    (
      length(
        TRIM(
          both
          from
            reason
        )
      ) > 0
    )
  ),
  constraint event_excused_students_revocation_complete check (
    (
      (
        (revoked_at is null)
        and (revoked_by is null)
        and (revoked_reason is null)
      )
      or (
        (revoked_at is not null)
        and (revoked_by is not null)
        and (
          NULLIF(btrim(revoked_reason), ''::text) is not null
        )
      )
    )
  ),
  constraint event_excused_students_invalidation_proof_revoked check (
    (
      (invalidation_proof_data is null)
      or (revoked_at is not null)
    )
  )
) TABLESPACE pg_default;

create index IF not exists idx_event_excused_students_active_event_student on public.event_excused_students using btree (event_id, student_id) TABLESPACE pg_default
where
  (revoked_at is null);

create index IF not exists idx_event_excused_students_event on public.event_excused_students using btree (event_id) TABLESPACE pg_default;

create index IF not exists idx_event_excused_students_student on public.event_excused_students using btree (student_id) TABLESPACE pg_default;

create trigger audit_ebams_event_excused_students
after INSERT
or DELETE
or
update on event_excused_students for EACH row
execute FUNCTION audit_ebams_system_activity ('event_excused_student');